node_modules/
dist/

# Generated by `cdm install`. The TYPE augmentations ARE committed (below) so
# CI typechecks contract call sites — without them the registry handle is a bare
# `Contract<ContractDef>` and every call silently goes unchecked. The resolved
# artifacts under .cdm/contracts/ are NOT committed: they snapshot per-version
# contract addresses we never read (addresses resolve live from the CDM
# meta-registry), so they would be a second, stale source of truth.
.cdm/*
!.cdm/cdm.d.ts
!.cdm/contracts.d.ts
docs-internal/
docs/superpowers/
.worktrees/
reference-repos/
.tokensave
e2e-reports/

# Environment files — never commit real credentials. `.env.example` is allow-listed.
.env*
!.env.example

# OS / editor cruft
.DS_Store

# Per-developer Claude Code state (team config in CLAUDE.md / AGENTS.md stays tracked)
.claude/settings.local.json
.claude/sessions/
.claude/cache/
